{
  "functions": { "api/data.js": { "maxDuration": 60, "memory": 1024 }, "api/email.js": { "maxDuration": 60, "memory": 1024 } },
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "same-origin" },
      { "key": "X-Robots-Tag", "value": "noindex" }
    ] }
  ]
}
